{
  "name": "entremomentos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:unified",
    "preview": "BUILD_PROFILE=unified astro preview --outDir dist/unified",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify": "npm run check && npm run lint && npm run format:check && npm test && npm run build:public && npm run build:personal && npm run build:unified",
    "build:public": "node scripts/build-profile.mjs public && node scripts/check-story-build.mjs",
    "build:personal": "node scripts/build-profile.mjs personal",
    "preview:personal": "BUILD_PROFILE=personal astro preview --outDir dist/personal --host 127.0.0.1",
    "build:unified": "node scripts/build-profile.mjs unified && node scripts/check-story-build.mjs unified",
    "preview:public": "BUILD_PROFILE=public astro preview --outDir dist/public --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "astro": "^7.4.11",
    "gsap": "^3.15.1",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "^4.1.12"
  }
}
