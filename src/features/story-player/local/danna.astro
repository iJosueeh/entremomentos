---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import { StoryPlayer } from '../index';
import { dannaStory } from './danna-story';
import './preview.css';
---

<BaseLayout
  title={`${dannaStory.title} · EntreMomentos`}
  description="Una dedicatoria para ti."
  noindex
  fullWidthContent
  publicSiteUrl={
    import.meta.env.BUILD_PROFILE === 'personal'
      ? 'https://entremomentos.vercel.app'
      : undefined
  }
>
  <div class="dedication-preview">
    <StoryPlayer story={dannaStory} client:load />
  </div>
</BaseLayout>
